---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NoteRows from '../../components/NoteRows.astro';
import { getNotes, getProjects } from '../../data';

export async function getStaticPaths() {
  const projects = (await getProjects()).filter((p) => (p.body ?? '').trim().length > 0);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const notes = (await getNotes()).filter((n) => n.data.project === project.id);
const d = project.data;
---
<Base title={d.title} description={d.summary}>
  <p class="cmd">cat projects/{project.id}/README.md</p>
  <h1>{d.title}</h1>
  <p class="page-meta">{d.summary}</p>
  <dl class="facts">
    <dt>Status</dt><dd>{d.status}</dd>
    <dt>Stack</dt><dd>{d.stack.join(', ')}</dd>
    {d.url && <><dt>Live</dt><dd><a href={d.url}>{d.url.replace(/^https?:\/\//, '')}</a></dd></>}
    {d.repo && <><dt>Source</dt><dd><a href={d.repo}>{d.repo.replace(/^https?:\/\//, '')}</a></dd></>}
  </dl>
  <div class="md"><Content /></div>
  {notes.length > 0 && (
    <section>
      <h2 class="cmd">grep -l {project.id} notes/</h2>
      <NoteRows notes={notes} />
    </section>
  )}
  <p class="back"><a href="/notes/">← notes/</a></p>
</Base>
