---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getLog, getSystems, isoDate } from '../../data';

export async function getStaticPaths() {
  const log = await getLog();
  return log.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const isSystem = (await getSystems()).some((s) => s.id === entry.data.system);
---
<Base title={entry.data.title} description={entry.data.lines.join(' ')}>
  <p class="cmd">cat ~/log/{entry.id}.md</p>
  <h1>{entry.data.title}</h1>
  <p class="meta">
    {isoDate(entry.data.date)} ·{' '}
    {isSystem ? <a href={`/systems/${entry.data.system}/`}>{entry.data.system}</a> : entry.data.system}
    {entry.data.draft && <span class="warn"> · [draft]</span>}
  </p>
  {entry.data.lines.length > 0 && (
    <div class="panel"><ul>{entry.data.lines.map((l) => <li>{l}</li>)}</ul></div>
  )}
  <div class="md"><Content /></div>
  <p><a href="/log/">← ~/log</a></p>
</Base>
