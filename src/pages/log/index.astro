---
import Base from '../../layouts/Base.astro';
import LogFeed from '../../components/LogFeed.astro';
import { getLog, getSystems } from '../../data';
const [log, systems] = await Promise.all([getLog(), getSystems()]);
---
<Base title="log" description="Chronological engineering log: experiments, eval runs, gotchas.">
  <p class="cmd">cat ~/log</p>
  <p class="dim">{log.length} entries · newest first</p>
  <LogFeed entries={log} systemSlugs={systems.map((s) => s.id)} />
</Base>
