---
import Base from '../layouts/Base.astro';
import LogFeed from '../components/LogFeed.astro';
import SystemsTable from '../components/SystemsTable.astro';
import { getLog, getSystems } from '../data';
import { WHOAMI, SITE } from '../site';

const [log, systems] = await Promise.all([getLog(), getSystems()]);
const slugs = systems.map((s) => s.id);
---
<Base>
  <section>
    <p class="cmd">whoami</p>
    <h1>{SITE.name}</h1>
    <dl class="kv">{WHOAMI.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
  </section>

  <section>
    <p class="cmd">ls ~/systems</p>
    <SystemsTable systems={systems} />
  </section>

  <section>
    <p class="cmd">tail -n 10 ~/log</p>
    <LogFeed entries={log.slice(0, 10)} systemSlugs={slugs} />
    {log.length > 10 && <p><a href="/log/">cat ~/log →</a></p>}
  </section>
</Base>
