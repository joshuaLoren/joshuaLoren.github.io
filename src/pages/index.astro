---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPosts, getProjects } from '../posts';

const posts = (await getPosts()).slice(0, 5);
const projects = (await getProjects()).slice(0, 4);
---
<Base>
  <p class="eyebrow">Accounting engineer</p>
  <h1>Hi, I'm Joshua.</h1>
  <p class="lede">
    I build the systems underneath accounting and payments: billing, money movement, the ledger,
    and lately the AI that sits on top of them. This is where I share what I'm building and learning.
  </p>

  <h2>Recent writing</h2>
  <PostList posts={posts} />
  <p><a href="/writing/">All writing →</a></p>

  <h2>Projects</h2>
  <div class="cards">{projects.map((p) => <ProjectCard project={p} />)}</div>
  <p><a href="/projects/">All projects →</a></p>
</Base>
