---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts } from '../../../posts';
import { SERIES } from '../../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return Object.entries(SERIES).map(([series, info]) => ({
    params: { series },
    props: { info, posts: posts.filter((p) => p.data.series === series) },
  }));
}
const { info, posts } = Astro.props;
---
<Base title={info.name} description={info.description}>
  <p class="eyebrow"><a href="/writing/">← Writing</a> · Series</p>
  <h1>{info.name}</h1>
  <p class="lede">{info.description}</p>
  <div style="margin-top:32px">
    {posts.length ? <PostList posts={posts} /> : <p>First entry coming soon.</p>}
  </div>
</Base>
