---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../posts';
import { fmtDate } from '../../format';
import { SERIES } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const series = post.data.series ? SERIES[post.data.series] : undefined;
---
<Base title={post.data.title} description={post.data.description}>
  <p class="eyebrow"><a href="/writing/">← Writing</a></p>
  <h1>{post.data.title}</h1>
  <div class="post-meta">
    <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
    {post.data.draft && <> · <strong>Draft</strong></>}
    {post.data.tags.length > 0 && <div class="tags">{post.data.tags.map((t) => <span class="chip">{t}</span>)}</div>}
  </div>
  {series && (
    <p class="series-note">Part of <a href={`/writing/series/${post.data.series}/`}>{series.name}</a>.</p>
  )}
  <article class="prose"><Content /></article>
</Base>
