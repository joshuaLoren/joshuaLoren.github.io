---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../posts';
const posts = await getPosts();
---
<Base title="Writing" description="Notes and essays on payments, accounting systems, and applied AI.">
  <h1>Writing</h1>
  <p class="lede">Notes, write-ups, and things I figured out the hard way.</p>
  <div style="margin-top:32px"><PostList posts={posts} /></div>
</Base>
