---
import type { CollectionEntry } from 'astro:content';
import { fmtDate } from '../format';
interface Props { tils: CollectionEntry<'til'>[] }
---
<ul class="list">
  {Astro.props.tils.map((t) => (
    <li>
      <time datetime={t.data.date.toISOString()}>{fmtDate(t.data.date)}</time>
      <div>
        <a href={`/til/${t.id}/`}>{t.data.title}</a>
        {t.data.tags.length > 0 && <p>{t.data.tags.join(' · ')}</p>}
      </div>
    </li>
  ))}
</ul>
