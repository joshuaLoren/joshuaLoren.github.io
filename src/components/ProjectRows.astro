---
import type { CollectionEntry } from 'astro:content';
interface Props { projects: CollectionEntry<'projects'>[] }

// A project gets an internal page only if its markdown has a body.
const hasWriteup = (p: CollectionEntry<'projects'>) => (p.body ?? '').trim().length > 0;
---
<ul class="rows">
  {Astro.props.projects.map((p) => {
    const main = p.data.url ?? (hasWriteup(p) ? `/projects/${p.id}/` : p.data.repo);
    return (
      <li>
        <div class="row-head">
          <a href={main}>{p.data.title}</a>
          <span class="row-meta">{p.data.status}</span>
        </div>
        <p>{p.data.summary}</p>
        <p class="links">
          {[
            p.data.url && <a href={p.data.url}>Live</a>,
            hasWriteup(p) && <a href={`/projects/${p.id}/`}>Write-up</a>,
            p.data.repo && <a href={p.data.repo}>Source</a>,
            p.data.pkg && <a href={p.data.pkg}>npm</a>,
          ].filter(Boolean)}
          {p.data.stack.length > 0 && <span class="muted">{p.data.stack.join(', ')}</span>}
        </p>
      </li>
    );
  })}
</ul>
