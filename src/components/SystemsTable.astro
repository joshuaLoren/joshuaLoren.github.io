---
import type { CollectionEntry } from 'astro:content';
interface Props { systems: CollectionEntry<'systems'>[] }
---
<table class="ls">
  <tbody>
    {Astro.props.systems.map((s) => (
      <tr>
        <td class="name"><a href={`/systems/${s.id}/`}>{s.id}</a></td>
        <td>
          {s.data.tagline}
          <div class="dim">{s.data.stack.join(' · ')}</div>
        </td>
        <td class="metric">
          <span class={`status ${s.data.status}`}>[{s.data.status}]</span>
          {s.data.metric && <div class="dim">{s.data.metric}</div>}
        </td>
      </tr>
    ))}
  </tbody>
</table>
