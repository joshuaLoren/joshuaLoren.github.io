---
import type { CollectionEntry } from 'astro:content';
import { isoDate } from '../data';
interface Props { entries: CollectionEntry<'log'>[]; systemSlugs: string[] }
const { entries, systemSlugs } = Astro.props;
---
<ol class="log">
  {entries.map((e) => (
    <li>
      <time datetime={e.data.date.toISOString()}>{isoDate(e.data.date)}</time>
      <span class="sys">
        {systemSlugs.includes(e.data.system) ? <a href={`/systems/${e.data.system}/`}>{e.data.system}</a> : e.data.system}
      </span>
      <div class="body">
        <a class="title" href={`/log/${e.id}/`}>{e.data.title}</a>
        {e.data.draft && <span class="warn"> [draft]</span>}
        {e.data.lines.length > 0 && <ul class="lines">{e.data.lines.map((l) => <li class="dim">{l}</li>)}</ul>}
      </div>
    </li>
  ))}
</ol>
